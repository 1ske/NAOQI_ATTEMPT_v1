diff --git a/controllers/naoqisim/naoqisim.cpp b/controllers/naoqisim/naoqisim.cpp
index 40018e4..76f0273 100644
--- a/controllers/naoqisim/naoqisim.cpp
+++ b/controllers/naoqisim/naoqisim.cpp
@@ -24,6 +24,25 @@ static void printUsage() {
 
 Mutex *halInitializationMutex=NULL;
 
+static int timeStep;
+static bool useCameras = true;
+static Nao *nao = NULL;
+
+#ifndef _WIN32
+// Run by SimLauncher::launch() once hal is up and before naoqi starts. The SDK requires it to send
+// every sensor value (sim_launcher.h). Without it HAL served NaN joint positions until the main loop
+// started, ALMotion's joint velocity filter took them in at startup and stayed NaN, and so did its
+// odometry (getRobotPosition), which made moveTo() do nothing.
+static void initSimulator() {
+  nao = new Nao(timeStep, useCameras);
+  for (int i = 0; i < 2; i++) {  // Webots sensors have their first sample after one step
+    wb_robot_step(timeStep);
+    nao->update();
+  }
+  cout << "===== sensors sent to HAL before NAOqi start =====\n" << flush;
+}
+#endif
+
 #ifdef _WIN32 // TODO: remove this case when Aldebaran release the fixed simulator-sdk for Mac and Linux 64
 static void halInitializedCallback();
 #endif
